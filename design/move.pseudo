# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

FUNCTION move(current_room, direction)
    
    OUTPUT 'Please enter your direction'
    INPUT direction

    IF direction command is valid/True THEN:
        OUTPUT 'movement is possible'
        current_room = new_room

    ELSE:
        OUTPUT 'You can't go that way'
        OUTPUT 'Available exits from current_room'
        
    END IF

    RETURN current_room
    
END FUNCTION

game_over = FALSE
current_room = starting_room

WHILE game_over == FALSE:
    current_room = move(current_room)

    IF current_room == last_room:
        OUTPUT You have reached the last_room
        game_over = TRUE
    END IF

END WHILE
