# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

    FUNCTION get_item(current_room, item, player_inventory)

        OUTPUT "Is the item already in the player inventory?
        INPUT "Enter your item command"

        IF item IN player_inventory:

            OUTPUT "item already in player_inventory"

        ELSE IF item IN current_room:

            ADD item to player_inventory
            OUTPUT " Yay! New item added in your inventory"
            
        ELSE:
        
            OUTPUT "No such item in room"

        Return player_inventory

END get_item


WHILE game_over == FALSE:
    OUTPUT current_room detail
    INPUT "Please enter your item command:" INTO item

    IF item In current_room:
        player_inventory = get_item(current_room, item, player_inventory)
    
    CONTINUE gameplay

END WHILE

